	(text "VSS: GND\nVCC: System Power\nVBAT: Battery Power\nXI: Crystal In\nXO: Crystal Out\nSDA: I2C data (in/out)\nSCL: I2C interface clock\nEXTI: External interrupt input\nWDI: Watchdog reset input\nnEXTR: External reset input\n\nOutputs:\nFOUT/nIRQ: Int 1/function output\nPSW/nIRQ2: Int 2/power switch output\nCLKOUT/nIRQ3 INT 3/clock output\nnTIRQ: Timer interrupt output\nnRST: Reset output"
		(exclude_from_sim no)
		(at 15.24 150.114 0)
		(effects
