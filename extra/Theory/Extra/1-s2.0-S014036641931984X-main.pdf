<dc:title>Energy-efficient and SDN-enabled routing algorithm for wireless body area networks</dc:title>
<dc:creator>
   <rdf:Seq>
     <rdf:li>Murtaza Cicio&#x011F;lu</rdf:li>
     <rdf:li>Ali &#x00C7;alhan</rdf:li>
   </rdf:Seq>
